{
  "name": "simfea-studio",
  "version": "0.1.0",
  "private": false,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "install-reqs": "pnpm install && python -m pip install -e .",
    "dev:api": "python src/backends/main.py",
    "dev:frontend": "vite",
    "dev:tauri": "tauri dev",
    "dev:all": "concurrently \"python src/backends/main.py\" \"pnpm dev:frontend\"",
    "release:windows": "pnpm build:sidecar-winos && pnpm tauri build",
    "build:sidecar-winos": "pyinstaller -c -F --clean --name main-x86_64-pc-windows-msvc --distpath src-tauri/bin/api --add-binary \"%CONDA_PREFIX%\\Library\\bin\\libssl-3-x64.dll;.\" --add-binary \"%CONDA_PREFIX%\\Library\\bin\\libcrypto-3-x64.dll;.\" src/backends/main.py",
    "build:sidecar-macos-x86_64": "pyinstaller -c -F --clean --name main-x86_64-apple-darwin --distpath src-tauri/bin/api src/backends/main.py",
    "build:sidecar-macos-aarch64": "pyinstaller -c -F --clean --name main-aarch64-apple-darwin --distpath src-tauri/bin/api src/backends/main.py",
    "build:sidecar-macos-all": "pnpm build:sidecar-macos-x86_64 && pnpm build:sidecar-macos-aarch64",
    "build:sidecar-linux": "pyinstaller -c -F --clean --name main-x86_64-unknown-linux-gnu --distpath src-tauri/bin/api src/backends/main.py",
    "build:icons": "pnpm tauri icon public/app-icon.png",
    "build": "vite build",
    "docker:build": "pnpm build && docker compose build",
    "docker:up": "pnpm build && docker compose up -d --build",
    "docker:down": "docker compose down",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:benchmarks": "python scripts/check_benchmark_contract.py",
    "build:learning-path": "python scripts/build_benchmark_learning_path.py",
    "lint": "biome check app/",
    "format": "biome check --write app/",
    "prepare": "husky"
  },
  "dependencies": {
    "@kitware/vtk.js": "^34.11.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.4.3",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "vue": "^3.5.13",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "app/**/*.{ts,vue,js}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{css,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tauri-apps/cli": "^2.5.0",
    "@types/cors": "^2.8.17",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "20.2.4",
    "@vitejs/plugin-vue": "^5.2.2",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "typescript": "5.0.4",
    "vite": "^6.3.1",
    "vitest": "^4.1.5"
  }
}
